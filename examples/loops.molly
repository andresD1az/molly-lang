# Control flow: if, while and for.
# let declares a constant; a variable declared with its type can change.
let limit = 5;
int i = 1;
int factorial = 1;

while i <= limit do
  factorial = factorial * i;
  i = i + 1;
end
send public_web("5! = " + factorial);

# for iterates over a list, a set or a str. [1 .. 10] is a range.
int evens = 0;
for n in [1 .. 10] do
  if n % 2 == 0 then
    evens = evens + 1;
  end
end
send public_web("Even numbers between 1 and 10: " + evens);

# Iterate over a str one char at a time.
str reversed = "";
for letter in "molly" do
  reversed = letter + reversed;
end
send public_web(reversed);
